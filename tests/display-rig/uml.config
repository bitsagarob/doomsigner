# The kernel options ss_display_capture needs, merged over `make ARCH=um defconfig`.
#
# SPI is not reachable from a stock UML defconfig. It depends on HAS_IOMEM, which
# on this architecture only appears through UML's PCI-over-virtio emulation, so
# asking for CONFIG_SPI alone gets silently dropped by olddefconfig and the
# module compiles cleanly and then fails to link against a kernel that has no SPI
# in it. Enabling the chain explicitly is the difference.
#
#   make ARCH=um defconfig
#   scripts/kconfig/merge_config.sh -m .config tests/display-rig/uml.config
#   make ARCH=um olddefconfig
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# the chain that makes HAS_IOMEM, and therefore SPI, available under UML
CONFIG_VIRTIO_UML=y
CONFIG_UML_PCI_OVER_VIRTIO=y
CONFIG_UML_PCI_OVER_VIRTIO_DEVICE_ID=1

# the bus the app's driver opens as /dev/spidev0.0
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_SPIDEV=m

# the gpiochip the app's buttons and its data/command line land on
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_CDEV_V1=y
